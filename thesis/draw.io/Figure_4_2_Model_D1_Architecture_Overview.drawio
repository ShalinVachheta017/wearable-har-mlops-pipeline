    <mxCell id="b1" value="&lt;b&gt;Input window (200, 6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;4 seconds of six-channel wearable sensor data at 50 Hz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f8fbff;strokeColor=#1f5fae;strokeWidth=2;fontFamily=Helvetica;fontSize=22;fontColor=#0b214a;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
