    <mxCell id="b2" value="&lt;b&gt;1D-CNN feature extraction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Temporal convolution filters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f8fbff;strokeColor=#1f5fae;strokeWidth=2;fontFamily=Helvetica;fontSize=22;fontColor=#0b214a;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
