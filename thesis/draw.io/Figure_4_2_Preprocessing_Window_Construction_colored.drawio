        <!-- Main step boxes -->
        <mxCell id="s1" value="&lt;b&gt;Raw sensor files&lt;/b&gt;&lt;br&gt;accelerometer CSV + gyroscope CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="175" width="210" height="82" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Schema alignment&lt;/b&gt;&lt;br&gt;map source columns to canonical names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0284C7;strokeWidth=2;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="285" y="175" width="210" height="82" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Unit harmonization&lt;/b&gt;&lt;br&gt;accelerometer: milli-g → m/s²&lt;br&gt;gyroscope: deg/s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="540" y="175" width="210" height="82" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Temporal alignment&lt;/b&gt;&lt;br&gt;resample / align to 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="795" y="175" width="210" height="82" as="geometry"/></mxCell>

