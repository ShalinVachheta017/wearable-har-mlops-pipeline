        <!-- Notes -->
        <mxCell id="label_rule" value="&lt;b&gt;Label-safety rule:&lt;/b&gt; unlabeled inference windows are created continuously across the uploaded recording. For labeled training or evaluation, windows should avoid mixing different activity labels or subject/session boundaries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontSize=12;fontColor=#111827;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="555" width="920" height="58" as="geometry"/></mxCell>
