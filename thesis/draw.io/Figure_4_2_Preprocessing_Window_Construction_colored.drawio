        <mxCell id="s7" value="&lt;b&gt;Sliding-window construction&lt;/b&gt;&lt;br&gt;window: 200 samples | stride: 100&lt;br&gt;overlap: 50% | duration: 4 s at 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=13;fontColor=#111827;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="528" y="409" width="235" height="94" as="geometry"/></mxCell>
