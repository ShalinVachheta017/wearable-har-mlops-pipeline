        <mxCell id="t" value="Preprocessing and Window Construction" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="160" y="20" width="980" height="40" as="geometry"/></mxCell><mxCell id="s1i" value="📄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="50" height="50" as="geometry"/></mxCell><mxCell id="s1" value="Raw accelerometer CSV&lt;br&gt;+ raw gyroscope CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="s2i" value="⚙" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="50" height="50" as="geometry"/></mxCell><mxCell id="s2" value="Schema alignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="s3i" value="⇄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="50" height="50" as="geometry"/></mxCell><mxCell id="s3" value="Unit harmonization&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;accelerometer: milliG → m/s²&lt;br&gt;gyroscope: °/s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="s4i" value="⏱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="50" height="50" as="geometry"/></mxCell><mxCell id="s4" value="Temporal alignment&lt;br&gt;and resampling&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;50 Hz&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="s5i" value="▦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="310" width="50" height="50" as="geometry"/></mxCell><mxCell id="s5" value="Canonical channel ordering&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;Ax, Ay, Az, Gx, Gy, Gz&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="s6i" value="Σ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="50" height="50" as="geometry"/></mxCell><mxCell id="s6" value="Apply saved training-data scaler&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;defined from training dataset&lt;br&gt;loaded from runtime contract&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="s7i" value="▱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="310" width="50" height="50" as="geometry"/></mxCell><mxCell id="s7" value="Sliding-window construction&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;200 samples | stride 100&lt;br&gt;50% overlap | 4 s/window&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="s8i" value="▣" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="50" height="50" as="geometry"/></mxCell><mxCell id="s8" value="Model-ready tensor&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;(N, 200, 6)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=16;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="es1s2" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es2s3" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es3s4" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es4s5" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es5s6" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es6s7" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es7s8" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Note:&lt;/b&gt; For unlabeled inference data, windows are created continuously across the uploaded recording. For labeled training or evaluation data, window construction should remain label-safe and should avoid mixing activity labels or subject/session boundaries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;arcSize=8;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="130" y="450" width="1040" height="70" as="geometry"/></mxCell>
