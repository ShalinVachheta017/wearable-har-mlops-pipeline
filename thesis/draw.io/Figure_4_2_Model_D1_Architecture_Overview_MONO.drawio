<mxfile host="app.diagrams.net" modified="2026-05-30T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram name="Figure 4.2 - Model D1 Architecture Overview">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Model D1 Architecture Overview" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="m1i" value="▦" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="65" width="50" height="45" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;1. Input window&lt;br&gt;(200, 6)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;4 seconds of six-channel wearable sensor data at 50 Hz&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="m2i" value="▤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="65" width="50" height="45" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;2. 1D-CNN feature extraction&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;Temporal convolution filters&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="315" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="m3i" value="↔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="655" y="65" width="50" height="45" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;3. BiLSTM sequence modelling&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;Captures temporal dependencies across the full window&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="m4i" value="◎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="65" width="50" height="45" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;4. Dense classification block&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;Transforms learned motion features into class-discriminative representations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="825" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="m5i" value="▥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="65" width="50" height="45" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;5. 11-class softmax output&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;Fixed label order&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="220" height="140" as="geometry"/></mxCell><mxCell id="em1m2" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em2m3" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em3m4" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em4m5" style="endArrow=block;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;endFill=1;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="contract" value="🛡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="50" height="50" as="geometry"/></mxCell><mxCell id="contractbox" value="&lt;b&gt;Runtime contract:&lt;/b&gt; same channel order, unit convention, saved scaler, monitoring baseline, and fixed label order defined from the training data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;arcSize=8;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="190" y="320" width="960" height="70" as="geometry"/></mxCell><mxCell id="footeri" value="⚙" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=18;fontStyle=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="425" width="50" height="50" as="geometry"/></mxCell><mxCell id="footer" value="Final runtime model: &lt;b&gt;Model D1&lt;/b&gt;, 967,499 total parameters." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontColor=#000000;fontSize=16;fontStyle=1;arcSize=8;spacing=10;" vertex="1" parent="1"><mxGeometry x="190" y="420" width="960" height="60" as="geometry"/></mxCell>
      </root>
