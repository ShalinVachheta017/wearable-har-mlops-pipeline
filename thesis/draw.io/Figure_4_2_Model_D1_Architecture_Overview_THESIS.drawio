  <diagram id="d0aa47fe8142" name="Figure 4.2 - Model D1 Architecture Overview">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Model D1 Architecture Overview" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="170" y="25" width="760" height="42" as="geometry"/></mxCell><mxCell id="sub" value="Conceptual architecture and runtime-contract boundary for the defended HAR model" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="220" y="65" width="660" height="24" as="geometry"/></mxCell><mxCell id="im1" value="▦" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.2;strokeColor=#222222;fillColor=#f3f3f3;fontSize=22;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="118" y="120" width="46" height="46" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;1. Input window&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;(200, 6)&lt;/font&gt;&lt;br&gt;&lt;br&gt;4 seconds of six-channel wearable data at 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;strokeColor=#222222;fillColor=#ffffff;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="40" y="185" width="180" height="190" as="geometry"/></mxCell><mxCell id="im2" value="▥" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.2;strokeColor=#222222;fillColor=#f3f3f3;fontSize=22;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="333" y="120" width="46" height="46" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;2. 1D-CNN feature extraction&lt;/b&gt;&lt;br&gt;&lt;br&gt;Temporal convolution filters learn local motion patterns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;strokeColor=#222222;fillColor=#ffffff;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="255" y="185" width="180" height="190" as="geometry"/></mxCell><mxCell id="im3" value="⇄" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.2;strokeColor=#222222;fillColor=#f3f3f3;fontSize=22;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="548" y="120" width="46" height="46" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;3. BiLSTM sequence modelling&lt;/b&gt;&lt;br&gt;&lt;br&gt;Captures temporal dependencies across the full 4-second window" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;strokeColor=#222222;fillColor=#ffffff;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="470" y="185" width="180" height="190" as="geometry"/></mxCell><mxCell id="im4" value="◌" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.2;strokeColor=#222222;fillColor=#f3f3f3;fontSize=22;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="763" y="120" width="46" height="46" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;4. Dense classification block&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transforms learned motion features into class-discriminative representations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;strokeColor=#222222;fillColor=#ffffff;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="685" y="185" width="180" height="190" as="geometry"/></mxCell><mxCell id="im5" value="▤" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.2;strokeColor=#222222;fillColor=#f3f3f3;fontSize=22;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="978" y="120" width="46" height="46" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;5. 11-class softmax output&lt;/b&gt;&lt;br&gt;&lt;br&gt;Class probabilities with fixed label order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;strokeColor=#222222;fillColor=#ffffff;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="900" y="185" width="180" height="190" as="geometry"/></mxCell><mxCell id="em1m2" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em2m3" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em3m4" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em4m5" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="contract" value="&lt;b&gt;Runtime contract:&lt;/b&gt; same channel order, unit convention, saved scaler, monitoring baseline, and fixed label order must be used with the model." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.2;strokeColor=#444444;fillColor=#f7f7f7;fontSize=10;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;spacing=10;" parent="1" vertex="1"><mxGeometry x="75" y="430" width="950" height="62" as="geometry"/></mxCell><mxCell id="param" value="&lt;b&gt;Final runtime model:&lt;/b&gt; Model D1, 967,499 total parameters." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.6;strokeColor=#111111;fillColor=#f5f5f5;fontSize=13;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="260" y="520" width="580" height="52" as="geometry"/></mxCell>
