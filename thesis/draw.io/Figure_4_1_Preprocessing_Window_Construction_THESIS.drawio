: 100&lt;br&gt;overlap: 50% | duration: 4 s at 50 Hz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.3;strokeColor=#222222;fillColor=#ffffff;fontSize=12;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="560" y="380" width="210" height="88" as="geometry"/></mxCell><mxCell id="ip8" value="▧" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.2;strokeColor=#222222;fillColor=#f3f3f3;fontSize=22;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="810" y="330" width="42" height="42" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;Model-ready tensor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;(N, 200, 6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.6;strokeColor=#111111;fillColor=#f5f5f5;fontSize=13;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacing=8;" parent="1" vertex="1"><mxGeometry x="810" y="380" width="210" height="88" as="geometry"/></mxCell><mxCell id="ep4p5" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep5p6" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep6p7" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ep7p8" style="endArrow=block;html=1;rounded=0;strokeWidth=1.2;strokeColor=#222222;" parent="1" edge="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Label-safety rule:&lt;/b&gt; unlabeled inference windows are created continuously across 