# ============================================================================
# Docker Ignore File
# ============================================================================
# Exclude files from Docker build context to keep images small and fast
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# DVC
.dvc
.dvc_storage
*.dvc

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info
.eggs
.pytest_cache
.mypy_cache
.ruff_cache
*.egg
MANIFEST

# Virtual environments (directories only — not a .env secrets file, which does not exist in this repo)
venv/
.venv/
env/
.env/
.conda/

# IDE
.idea
.vscode
*.swp
*.swo

# Jupyter
.ipynb_checkpoints
*.ipynb

# Logs (we mount these as volumes)
logs/
*.log

# Data (we mount these as volumes)
data/raw/
data/processed/
data/prepared/
*.csv
*.xlsx
*.npy

# Models
# Keep pretrained artifacts in the build context so CD smoke tests can boot the API.
models/
!models/
!models/pretrained/
!models/pretrained/**
!models/normalized_baseline.json

# MLflow (we mount these as volumes)
mlruns/

# Documentation
docs/
*.md
!README.md

# Tests
tests/

# Archive
**/archive/
**/old_*/
**/backup/

# Misc
.DS_Store
Thumbs.db
*.bak
*.tmp

# ============================================================================
# Additions 2026-05-08 — observed in the current repo state
# ============================================================================

# ---- Historical / heavy folders at repo root ----
27 april meet/
6th may/
_archive/
recording/
main/
internal/
notes/
diagnostics/

# ---- Pipeline run outputs (regenerated; never bake into image) ----
artifacts/
outputs/
evidence/

# ---- Local pytest workspaces (Windows ACL workaround dirs) ----
stage6_pytest_work/
stage7_pytest_work/
tmp_run3/
.pytest_tmp/
.tmp_pytest/

# ---- Notebooks folder contents (extends *.ipynb to siblings such as keras/json/csv) ----
nb/
notebooks/

# ---- Office files and locks (xlsx already excluded under Data) ----
*.docx
*.doc
*.xls
~$*

# ---- PDFs and built thesis byproducts ----
*.pdf
thesis/
*.aux
*.bbl
*.blg
*.toc
*.lof
*.lot
*.out
*.synctex.gz

# ---- Coverage / mypy / tox ----
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---- Compressed dumps ----
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ---- Stray top-level scratch files ----
temp.txt
reasoningtxt.txt
pt.md
